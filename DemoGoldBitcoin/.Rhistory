knitr::opts_chunk$set(cache = TRUE, message = FALSE)
library(tidyquant)
library(tidyverse)
start_date <- as.Date("2017-01-01")
end_date   <- Sys.Date()
assets <- tibble(
symbol = c("BTC-USD", "GC=F", "DX-Y.NYB"),
asset  = c("Bitcoin", "Gold", "Dollar")
)
assets
prices <- tq_get(
assets$symbol,
from = start_date,
to = end_date
) |>
left_join(assets, join_by(symbol))
write_csv(prices, "data/prices.csv")
prices <- tq_get(
assets$symbol,
from = start_date,
to = end_date
) |>
left_join(assets, join_by(symbol))
write_csv(prices, "data/prices.csv")
prices <- tq_get(
assets$symbol,
from = start_date,
to = end_date
) |>
left_join(assets, join_by(symbol))
write_csv(prices, "data/prices.csv")
prices <- read_csv("data/prices.csv")
prices
prices <- prices |>
select(asset, symbol, date, close)
prices |>
group_by(asset) |>
summarise(
first_date = min(date),
last_date = max(date),
observations = n()
)
prices |>
ggplot(aes(x = date, y = close)) +
geom_line() +
facet_wrap(
~ asset,
scales = "free_y",
ncol = 1
) +
labs(
title = "Bitcoin, Gold and the U.S. Dollar Index",
subtitle = "January 2017 to today",
x = NULL,
y = NULL
)
knitr::opts_chunk$set(cache = TRUE, message = FALSE)
library(tidyquant)
library(tidyverse)
start_date <- as.Date("2017-01-01")
end_date   <- Sys.Date()
assets <- tibble(
symbol = c("BTC-USD", "GC=F", "DX-Y.NYB"),
asset  = c("Bitcoin", "Gold", "Dollar")
)
assets
prices <- read_csv("data/prices.csv")
prices
prices <- prices |>
select(asset, symbol, date, close)
prices |>
group_by(asset) |>
summarise(
first_date = min(date),
last_date = max(date),
observations = n()
)
prices |>
ggplot(aes(x = date, y = close)) +
geom_line() +
facet_wrap(
~ asset,
scales = "free_y",
ncol = 1
) +
labs(
title = "Bitcoin, Gold and the U.S. Dollar Index",
subtitle = "January 2017 to today",
x = NULL,
y = NULL
)
common_prices <- prices |>
select(date, asset, close) |>
pivot_wider(
names_from = asset,
values_from = close
) |>
drop_na()
common_prices_long <- common_prices |>
pivot_longer(
cols = c(Bitcoin, Gold, Dollar),
names_to = "asset",
values_to = "price"
)
indexed_prices <- common_prices_long |>
group_by(asset) |>
arrange(date) |>
mutate(
index = 100 * price / first(price)
) |>
ungroup()
indexed_prices |>
filter(asset %in% c("Bitcoin", "Gold")) |>
ggplot(aes(x = date, y = index, color = asset)) +
geom_line() +
labs(
title = "Bitcoin versus Gold",
subtitle = "Initial value = 100",
x = NULL,
y = "Index",
color = NULL
)
returns <- common_prices_long |>
group_by(asset) |>
arrange(date) |>
mutate(
return = price / lag(price) - 1
) |>
filter(!is.na(return)) |>
ungroup()
returns
returns |>
filter(asset %in% c("Bitcoin", "Gold")) |>
ggplot(aes(x = date, y = return)) +
geom_line() +
facet_wrap(
~ asset,
ncol = 1
) +
labs(
title = "Daily Returns",
subtitle = "Bitcoin and Gold",
x = NULL,
y = "Return"
)
returns |>
filter(asset %in% c("Bitcoin", "Gold")) |>
ggplot(aes(x = return)) +
geom_histogram(
bins = 80
) +
facet_wrap(
~ asset,
scales = "free_y"
) +
labs(
title = "Distribution of Daily Returns",
x = "Daily return",
y = "Frequency"
)
return_summary <- returns |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
summarise(
mean_daily = mean(return),
median_daily = median(return),
sd_daily = sd(return),
min_daily = min(return),
max_daily = max(return)
)
return_summary
performance <- common_prices_long |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
arrange(date) |>
summarise(
start_date = first(date),
end_date = last(date),
start_price = first(price),
end_price = last(price),
total_return = end_price / start_price - 1
)
performance
performance <- common_prices_long |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
arrange(date) |>
summarise(
start_date = first(date),
end_date = last(date),
start_price = first(price),
end_price = last(price),
total_return = end_price / start_price - 1
)
performance
performance <- common_prices_long |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
arrange(date) |>
summarise(
start_price = first(price),
end_price = last(price),
years = as.numeric(last(date) - first(date)) / 365.25,
total_return = end_price / start_price - 1,
CAGR =
(end_price / start_price)^(1 / years) - 1
)
performance
performance <- common_prices_long |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
arrange(date) |>
summarise(
start_price = first(price),
end_price = last(price),
years = as.numeric(last(date) - first(date)) / 365.25,
total_return = end_price / start_price - 1,
CAGR =
(end_price / start_price)^(1 / years) - 1
)
performance
volatility <- returns |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
summarise(
daily_volatility = sd(return),
annual_volatility = sd(return) * sqrt(252)
)
volatility
rolling_volatility <- returns |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
tq_mutate(
select = return,
mutate_fun = runSD,
n = 30,
col_rename = "rolling_sd"
) |>
mutate(
rolling_volatility = rolling_sd * sqrt(252)
) |>
ungroup()
rolling_volatility <- returns |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
tq_mutate(
select = return,
mutate_fun = runSD,
n = 30,
col_rename = "rolling_sd"
) |>
mutate(
rolling_volatility = rolling_sd * sqrt(252)
) |>
ungroup()
rolling_volatility |>
ggplot(
aes(
x = date,
y = rolling_volatility,
color = asset
)
) +
geom_line() +
labs(
title = "30-Day Rolling Annualized Volatility",
x = NULL,
y = "Annualized volatility",
color = NULL
)
## NOT WORKING WHEN KNITED
risk_free <- tq_get(
"DGS3MO",
get = "economic.data",
from = start_date,
to = end_date
)
write_csv(risk_free, "data/risk_free.csv")
risk_free <- read_csv("data/risk_free.csv")
risk_free
risk_free <- risk_free |>
select(date, price) |>
rename(rf_annual = price)
risk_free <- risk_free |>
complete(
date = seq.Date(
start_date,
end_date,
by = "day"
)
) |>
arrange(date) |>
fill(
rf_annual,
.direction = "downup"
)
risk_free <- risk_free |>
mutate(
rf_daily =
(1 + rf_annual / 100)^(1 / 252) - 1
)
returns_rf <- returns |>
filter(asset %in% c("Bitcoin", "Gold")) |>
left_join(select(risk_free, date, rf_daily), join_by(date)) |>
mutate(excess_return = return - rf_daily)
sharpe <- returns_rf |>
group_by(asset) |>
summarise(
mean_daily_excess =
mean(excess_return, na.rm = TRUE),
sd_daily_excess =
sd(excess_return, na.rm = TRUE),
sharpe =
mean_daily_excess /
sd_daily_excess *
sqrt(252)
)
sharpe
comparison <- common_prices_long |>
filter(asset %in% c("Bitcoin", "Gold")) |>
group_by(asset) |>
arrange(date) |>
summarise(
start_price = first(price),
end_price = last(price),
years = as.numeric(last(date) - first(date)) / 365.25,
total_return = end_price / start_price - 1,
CAGR = (end_price / start_price)^(1 / years) - 1) |>
left_join(select(volatility, asset, annual_volatility), join_by(asset)) |>
left_join(select(sharpe, asset, sharpe), join_by(asset))
comparison
comparison |>
mutate(
total_return =
scales::percent(total_return, accuracy = 0.1),
CAGR =
scales::percent(CAGR, accuracy = 0.1),
annual_volatility =
scales::percent(
annual_volatility,
accuracy = 0.1
),
sharpe =
round(sharpe, 2)
)
returns_wide <- returns |>
select(date, asset, return) |>
pivot_wider(
names_from = asset,
values_from = return
) |>
drop_na()
returns_wide
cor_matrix <- returns_wide |>
select(Bitcoin, Gold, Dollar) |>
cor()
cor_matrix
cor(
returns_wide$Bitcoin,
returns_wide$Gold
)
cor(
returns_wide$Bitcoin,
returns_wide$Dollar
)
cor(
returns_wide$Gold,
returns_wide$Dollar
)
dollar_relationship <- returns_wide |>
pivot_longer(
cols = c(Bitcoin, Gold),
names_to = "asset",
values_to = "asset_return"
)
dollar_relationship |>
ggplot(
aes(
x = Dollar,
y = asset_return
)
) +
geom_point(
alpha = 0.3
) +
geom_smooth(
method = "lm",
se = FALSE
) +
facet_wrap(
~ asset,
scales = "free_y"
) +
labs(
title = "Bitcoin and Gold versus the U.S. Dollar",
x = "Dollar Index return",
y = "Asset return"
)
dollar_relationship <- returns_wide |>
pivot_longer(
cols = c(Bitcoin, Gold),
names_to = "asset",
values_to = "asset_return"
)
dollar_relationship <- returns_wide |>
pivot_longer(
cols = c(Bitcoin, Gold),
names_to = "asset",
values_to = "asset_return"
)
yearly_correlations <- returns_wide |>
mutate(
year = format(date, "%Y")
) |>
group_by(year) |>
summarise(
bitcoin_gold =
cor(Bitcoin, Gold),
bitcoin_dollar =
cor(Bitcoin, Dollar),
gold_dollar =
cor(Gold, Dollar)
)
yearly_correlations
yearly_correlations_long <-
yearly_correlations |>
pivot_longer(
-year,
names_to = "pair",
values_to = "correlation"
)
yearly_correlations_long |>
ggplot(
aes(
x = year,
y = correlation,
color = pair,
group = pair
)
) +
geom_hline(
yintercept = 0,
linetype = "dashed"
) +
geom_line() +
geom_point() +
labs(
title = "Correlation through Time",
x = NULL,
y = "Correlation",
color = NULL
) +
theme(
axis.text.x =
element_text(
angle = 45,
hjust = 1
)
)
yearly_returns <- returns |>
filter(
asset %in%
c("Bitcoin", "Gold")
) |>
mutate(
year = format(date, "%Y")
) |>
group_by(asset, year) |>
summarise(
annual_return =
prod(1 + return) - 1,
.groups = "drop"
)
yearly_returns
yearly_returns |>
ggplot(
aes(
x = year,
y = annual_return,
fill = asset
)
) +
geom_col(
position = "dodge"
) +
scale_y_continuous(
labels = scales::percent
) +
labs(
title = "Annual Returns: Bitcoin versus Gold",
x = NULL,
y = "Annual return",
fill = NULL
) +
theme(
axis.text.x =
element_text(
angle = 45,
hjust = 1
)
)
