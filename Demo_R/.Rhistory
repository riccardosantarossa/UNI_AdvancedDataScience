library(tidyverse)
library(httr2)
install.packages("httr2")
library(tidyverse)
library(httr2)
# Define the GraphQL query
query <- '
query Votes {
votes(
where: {
proposal: "0xa9a2dc5a52ea54b478c4c5fea88540622dff7ad5000f8d146dff482c6e6b6055"
}
first: 1000
orderBy: "vp"
orderDirection: desc
) {
voter
choice
vp
}
}
'
# Send the query
response <-
request("https://hub.snapshot.org/graphql") |>
req_body_json(
list(query = query)
) |>
req_perform() |>
resp_body_json(
simplifyVector = TRUE
)
# Get the votes
votes = as_tibble(response$data$votes)
# Save as CSV
write_csv(votes, "votes.csv")
votes
knitr::opts_chunk$set(cache = TRUE, message = FALSE)
library(ineq)
votes = read_csv("votes.csv")
library(ineq)
library(tidyverse)
votes = read_csv("votes.csv")
yes =
votes %>%
filter(choice == 1) %>%
pull(vp)
no =
votes %>%
filter(choice == 2) %>%
pull(vp)
# Gini index
(gini_yes = Gini(yes))
(gini_no = Gini(no))
# Lorenz curve
Lc1 <- Lc(yes)
Lc2 <- Lc(no)
df_lorenz <- rbind(
data.frame(p = Lc1$p, L = Lc1$L, group = "Yes"),
data.frame(p = Lc2$p, L = Lc2$L, group = "No")
)
df_lorenz
(gini_yes = Gini(yes))
(gini_no = Gini(no))
Lc1
ggplot(df_lorenz, aes(p, L, colour = group)) +
geom_line(linewidth = 1) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
labs(
title = "Lorenz curve for approval (Yes) and denial (No) options",
subtitle = "Both voting distributions are highly concentrated, with Gini above 0.9",
x = "Cumulative population share",
y = "Cumulative value share",
colour = ""
) +
theme_minimal()
df_lorenz
outcomes =
votes |>
group_by(choice) |>
summarise(one_person_one_vote = n(), one_token_one_vote = sum(vp), qv = sum(sqrt(vp))) |>
mutate(share_one_person_one_vote = one_person_one_vote / sum(one_person_one_vote),
share_one_token_one_vote = one_token_one_vote / sum(one_token_one_vote),
share_qv = qv / sum(qv))
outcomes |>
filter(choice %in% c(1, 2)) |>
select(choice, contains("share")) |>
round(3)
