A = matrix(runif(100), nrow = 10)
microbenchmark(power(A, 100), fast_power(A, 100), times = 1000)
fast_power = function(A, n) {
if (n == 0) {
return(diag(nrow(A)))
}
if (n %% 2 == 0) {
B = fast_power(A, n %/% 2)
return(B %*% B)
} else {
return(A %*% fast_power(A, n - 1))
}
}
A = matrix(runif(100), nrow = 10)
microbenchmark(power(A, 100), fast_power(A, 100), times = 1000)
A = matrix(runif(100), nrow = 10)
microbenchmark(power(A, 100), fast_power(A, 100), times = 1000)
