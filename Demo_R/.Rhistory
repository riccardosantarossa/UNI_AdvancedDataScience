y = c("Hello", "Venus")
)
# a data frame
Jupiter = data.frame(
x = c(21, 23),
y = c("Hello", "Jupiter")
)
# a nested data frame
# I() treats the object ‘as is’
worlds = data.frame(
x = I(list(Venus, Jupiter)),
y = c("Hello", "Worlds")
)
