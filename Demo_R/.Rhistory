install.packages("microbenchmark")
knitr::opts_chunk$set(cache = TRUE, message = FALSE, warning = FALSE)
library(microbenchmark)
# A data frame
df = data.frame(
a = lubridate::now() + runif(1000) * 86400, # timestamp
b = lubridate::today() + runif(1000) * 30,  # date
c = 1:1000, # integer
d = runif(1000), # double
e = sample(letters, 1000, replace = TRUE) # character
)
# A matrix
mat = matrix(runif(5000), ncol = 5)
# Get a column
microbenchmark(mat[, 3], df[, 3])
# Get a row
microbenchmark(mat[1, ], df[1, ])
View(df)
View(mat)
