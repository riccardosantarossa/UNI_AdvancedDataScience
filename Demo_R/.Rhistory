numDivisors = function(n) {
n_divs = 0
for(i in 1:n)
if (i %% n == 0) n_divs = n_divs + 1
return n_divs
numDivisors = function(n) {
n_divs = 0
for(i in 1:n)
if (i %% n == 0) n_divs = n_divs + 1
return (n_divs)
}
numDivisors(6)
