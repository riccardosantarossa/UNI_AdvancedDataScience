limit: 1000
) {{
token_id
invocation
owner_address
minted_at
features
media_url
}}
}}
'
)
response <- read_rds("data/response.rds")
fidenza <- response$data$tokens_metadata |>
map_dfr(
function(x) {
tibble(
fidenza =
as.integer(x$invocation),
token_id =
as.numeric(x$token_id),
owner =
str_to_lower(x$owner_address),
minted_at =
ymd_hms(x$minted_at),
media_url =
x$media_url,
features =
list(x$features)
)
}
)
glimpse(fidenza)
fidenza |>
summarise(
artworks = n(),
first = min(fidenza),
last = max(fidenza)
)
fidenza$features[[1]]
traits <- fidenza |>
select(
fidenza,
token_id,
features
) |>
mutate(
features =
map(
features,
function(x) {
enframe(
unlist(x),
name = "trait",
value = "value"
)
}
)
) |>
unnest(features) |>
mutate(
value = as.character(value)
)
traits
traits |>
filter(fidenza == 0)
traits |>
distinct(trait) |>
arrange(trait)
traits |>
summarise(
n_traits =
n_distinct(trait)
)
traits |>
count(
trait,
name = "observations"
)
trait_frequency <- traits |>
count(
trait,
value,
name = "n"
) |>
group_by(trait) |>
mutate(
frequency =
n / sum(n)
) |>
ungroup()
trait_frequency |>
filter(trait == "Scale") |>
arrange(desc(frequency))
trait_frequency |>
filter(
trait %in%
c(
"Scale",
"Density",
"Turbulence",
"Colors"
)
) |>
ggplot(
aes(
x = value,
y = frequency
)
) +
geom_col() +
facet_wrap(
~ trait,
scales = "free_x"
) +
scale_y_continuous(
labels = scales::percent
) +
labs(
title = "Traits of Fidenza",
x = NULL,
y = "Share of collection"
) +
theme_minimal() +
theme(
axis.text.x =
element_text(
angle = 45,
hjust = 1
)
)
trait_frequency <- trait_frequency |>
mutate(
rarity_component =
-log(frequency)
)
trait_frequency
rarity <- traits |>
left_join(
trait_frequency,
by = c(
"trait",
"value"
)
) |>
summarise(
rarity_score =
sum(rarity_component),
.by =
c(
fidenza,
token_id
)
)
rarity <- rarity |>
mutate(
rarity_percentile =
100 *
percent_rank(
rarity_score
)
)
rarity |>
arrange(
desc(rarity_score)
) |>
slice_head(n = 10)
rarity |>
ggplot(
aes(rarity_score)
) +
geom_histogram(
bins = 50
) +
labs(
title = "Distribution of Fidenza rarity",
x = "Rarity score",
y = "Artworks"
) +
theme_minimal()
