graph_api_key <-
Sys.getenv("GRAPH_API_KEY")
graph_url <- str_c(
"https://gateway-arbitrum.network.thegraph.com/api/",
graph_api_key,
"/subgraphs/id/",
"6bR1oVsRUUs6czNiB6W7NNenTXtVfNd5iSiwvS4QbRPB"
)
get_transfer_batch <- function(
skip,
batch_size = 100
) {
query <- glue::glue(
'
{{
tokens(
first: {batch_size},
skip: {skip},
where: {{
project: "{project_id}"
}},
orderBy: invocation,
orderDirection: asc
) {{
tokenId
invocation
transfers(
first: 1000,
orderBy: blockTimestamp,
orderDirection: asc
) {{
id
from
to
transactionHash
blockNumber
blockTimestamp
}}
}}
}}
'
)
response <- request(graph_url) |>
req_body_json(
list(query = query)
) |>
req_perform() |>
resp_body_json(
simplifyVector = FALSE
)
if (!is.null(response$errors)) {
stop(response$errors[[1]]$message)
}
response$data$tokens |>
map_dfr(
function(token) {
if (
length(
token$transfers
) == 0
) {
return(tibble())
}
token$transfers |>
map_dfr(
function(transfer) {
tibble(
fidenza =
as.integer(
token$invocation
),
token_id =
as.numeric(
token$tokenId
),
transfer_id =
transfer$id,
from =
str_to_lower(
transfer$from
),
to =
str_to_lower(
transfer$to
),
transaction_hash =
transfer$transactionHash,
block =
as.numeric(
transfer$blockNumber
),
time =
as.POSIXct(
as.numeric(
transfer$blockTimestamp
),
origin =
"1970-01-01",
tz = "UTC"
)
)
}
)
}
)
}
skips <- seq(
from = 0,
to = nrow(fidenza) - 1,
by = 100
)
transfers <- map_dfr(
skips,
function(skip) {
message(
"Downloading tokens ",
skip + 1,
"–",
min(
skip + 100,
nrow(fidenza)
)
)
get_transfer_batch(skip)
}
)
write_csv(transfers, "data/transfers.csv")
transfers <- read_csv("data/transfers.csv")
transfers
install.packages(c("nlme", "parallelly"))
usethis::edit_r_environ()
